{
  "name": "clip-moment",
  "version": "0.1.0",
  "description": "Windows 剪切板助手 — 复制确认与历史管理",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1 && vite build && node scripts/build-electron.mjs",
    "start": "npm run preview",
    "preview": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.clipmoment.app",
    "productName": "ClipMoment",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ClipMoment"
    }
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
